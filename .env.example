# Copy to .env and fill in from your Supabase project
# (Project Settings -> API). Both values are safe for the browser:
# the anon key only ever acts through Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Keep false for an administrator-only deployment. Turning this on only
# exposes the resident registration screen; Supabase Authentication must
# also have "Allow new users to sign up" enabled.
VITE_RESIDENT_SELF_REGISTRATION=false

# NEVER put the service role key in this file or anywhere under src/.
# It belongs only in the edge function secrets:
#   supabase secrets set TAMS_BOOTSTRAP_SECRET=... TAMS_SITE_URL=...

# Optional. Where a password reset link should bring people back to.
# Left unset, TAMS uses the address the browser is already on, which is
# right in development. Set it for a deployed site so reset emails never
# send anybody to localhost.
VITE_APP_URL=http://localhost:5173
